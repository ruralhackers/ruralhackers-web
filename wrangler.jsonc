{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // ruralhackers.com: the static build in dist/, plus a Worker that only runs
  // for "/" (WordPress's /?p=ID links) and for the WPForms endpoint, which emails
  // form submissions through Resend (src/worker.ts, src/forms.ts).
  // Deploy with `bun run deploy`, which builds first: the Worker bundles
  // dist/_wp-ids.json.
  "name": "ruralhackers-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  // Both hostnames answer here; a zone redirect rule sends www to the apex.
  // Before this, ruralhackers.com was an A record to WordPress on Hostinger
  // (217.65.147.26) and www a CNAME to the apex, both DNS-only.
  "routes": [
    { "pattern": "ruralhackers.com", "custom_domain": true },
    { "pattern": "www.ruralhackers.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/wp-admin/admin-ajax.php"]
  }
}
