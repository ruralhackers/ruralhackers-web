---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { localesFor, pathFor, splitId } from '../../lib/entries.ts'
import { DEFAULT_LOCALE, LOCALES, localePath } from '../../lib/i18n.ts'

export async function getStaticPaths() {
  const kinds = ['pages', 'programmes', 'posts'] as const
  const prefixed = LOCALES.filter((l) => l !== DEFAULT_LOCALE)
  const paths = []
  for (const kind of kinds) {
    const all = await getCollection(kind)
    const ids = all.map((e) => e.id)
    for (const entry of all) {
      const { locale, slug } = splitId(entry.id)
      if (!prefixed.includes(locale)) continue
      const base = pathFor(kind, slug)
      // The home and the blog index have their own routes, as in English.
      if (base === '/' || base === '/blog/') continue
      paths.push({
        params: { locale, slug: base.replace(/^\/|\/$/g, '') },
        props: { entry, locale, path: base, availableLocales: localesFor(ids, slug) },
      })
    }
  }
  return paths
}

const { entry, locale, path, availableLocales } = Astro.props
const { Content } = await render(entry)
---
{/*
  The prefixed twin of src/pages/[...slug].astro. It only generates a route where
  a translated entry exists, so /es/about/ appears the moment about.mdx lands in
  es/ and not before — which is what keeps the header from linking at pages that
  are not there.
*/}
<BaseLayout
  title={entry.data.seoTitle ?? entry.data.title}
  description={entry.data.seoDescription}
  locale={locale}
  path={path}
  availableLocales={availableLocales}
>
  <Content />
</BaseLayout>
