---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { Section, Prose } from '../../../components/blocks/index.ts'
import { pathFor, splitId } from '../../../lib/entries.ts'
import { DEFAULT_LOCALE, LOCALES, localePath, type Locale } from '../../../lib/i18n.ts'
import { ui } from '../../../lib/ui.ts'

export async function getStaticPaths() {
  const all = await getCollection('posts')
  const prefixed = LOCALES.filter((l) => l !== DEFAULT_LOCALE)
  return prefixed
    .filter((locale) => all.some((e) => splitId(e.id).locale === locale))
    .map((locale) => ({ params: { locale }, props: { locale } }))
}

const { locale } = Astro.props as { locale: Locale }
const t = ui(locale)
const posts = (await getCollection('posts'))
  .filter((e) => splitId(e.id).locale === locale)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---
<BaseLayout title={`${t.blog} — Rural Hackers`} locale={locale} path="/blog/">
  <Section width="wide" space={50}>
    <h1 class="section-title">{t.blog}</h1>
    <div class="posts">
      {posts.map((p) => {
        const { slug } = splitId(p.id)
        return (
          <article>
            <h2 class="statement">
              <a href={localePath(locale, pathFor('posts', slug))}>{p.data.title}</a>
            </h2>
            <p class="meta">
              <time datetime={p.data.date.toISOString()}>
                {p.data.date.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </p>
            {p.data.seoDescription && <Prose size="small">{p.data.seoDescription}</Prose>}
          </article>
        )
      })}
    </div>
  </Section>
</BaseLayout>

<style>
  .posts { display: grid; gap: var(--space-60); max-width: 645px; }
  .posts h2 { margin: 0 0 var(--space-20); }
  .posts a:hover { color: var(--color-accent-1); text-decoration: none; }
  .meta { font-size: var(--size-small); color: var(--color-accent-4); margin: 0 0 var(--space-20); }
</style>
