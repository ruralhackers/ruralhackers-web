---
/**
 * Every page is the live ruralhackers.com html, mirrored by
 * scripts/mirror-live.ts into mirror/pages/. It is emitted as it is, plus the
 * new content kept in mirror/additions/ (see src/lib/additions.ts).
 */
import { applyAdditions, addProgress2026 } from '../lib/additions.ts'
import { build2026 } from '../lib/year-2026.ts'

export function getStaticPaths() {
  const files = import.meta.glob<string>('../../mirror/pages/**/index.html', {
    query: '?raw',
    import: 'default',
    eager: true,
  })
  return Object.entries(files).map(([file, html]) => {
    const slug = file.replace('../../mirror/pages/', '').replace(/\/?index\.html$/, '')
    return { params: { slug: slug || undefined }, props: { html: addProgress2026(applyAdditions(slug, html)) } }
  }).concat([{ params: { slug: '2026' }, props: { html: build2026() } }])
}

const { html } = Astro.props
---
<Fragment set:html={html} />
