---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { navFor } from '../lib/nav.ts'
import { ui } from '../lib/ui.ts'
import LanguageLinks from './LanguageLinks.astro'
import MobileNav from './MobileNav.astro'
import { localePath, DEFAULT_LOCALE, type Locale } from '../lib/i18n.ts'
import { pathFor, splitId } from '../lib/entries.ts'
import logo from '../assets/logo.png'

interface Props {
  locale: Locale
  path: string
  availableLocales: readonly Locale[]
}
const { locale, path, availableLocales } = Astro.props
const t = ui(locale)
const NAV = navFor(locale)

/*
 * Which paths actually exist in this locale.
 *
 * Prefixing every nav item with the current locale was wrong: on /es/ the whole
 * menu pointed at /es/contact/, /es/progress/2023/ and the rest, none of which are
 * translated, so every item in the header was a 404. A link is prefixed only when
 * there is a page behind it.
 */
const kinds = ['pages', 'programmes', 'years', 'posts'] as const
const translated = new Set<string>()
for (const kind of kinds) {
  for (const entry of await getCollection(kind)) {
    const { locale: l, slug } = splitId(entry.id)
    if (l !== locale) continue
    translated.add(kind === 'years' ? pathFor(kind, String(entry.data.year)) : pathFor(kind, slug))
  }
}
// /progress/ is a route rather than an entry; it exists per locale if any year does.
if ([...translated].some((p) => p.startsWith('/progress/'))) translated.add('/progress/')

const href = (h: string, external?: boolean) => {
  if (external) return h
  if (locale === DEFAULT_LOCALE) return h
  return translated.has(h) ? localePath(locale, h) : h
}
---
{/*
  Measured on the live site at 1440px: the logo renders 120x120, the nav sits
  right-aligned in a 103px-wide box at x=1287, its <ul> is flex-direction column,
  and its items are 18px Inter. The header itself has no padding of its own.
*/}
<header>
  <a class="logo" href={href('/')} aria-label={t.homeLabel}>
    <Image src={logo} alt="" width={120} height={120} layout="fixed" />
  </a>

  {/* Below 782px the desktop column is hidden and this takes over. */}
  <MobileNav locale={locale} path={path} availableLocales={availableLocales} href={href} />

  <div class="right">
    {/* Above the nav, in the same right-aligned column. */}
    <LanguageLinks locale={locale} path={path} availableLocales={availableLocales} />

    <nav aria-label={t.mainNav}>
      <ul>
        {NAV.map((item) => (
          <li>
            <a
              href={href(item.href, item.external)}
              {...(item.external ? { rel: 'noopener', target: '_blank' } : {})}
            >{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((child) => (
                  <li><a href={href(child.href, child.external)}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    max-width: var(--wide-size);
    margin: 0 auto;
    padding: 0 var(--space-40);
  }
  .logo { display: block; line-height: 0; }
  .right { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-20); padding-top: var(--space-20); }

  nav ul {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 18px;
  }
  nav li { position: relative; }
  nav .sub { display: none; }
  nav li:hover > .sub,
  nav li:focus-within > .sub {
    display: flex;
    position: absolute;
    right: 0;
    background: var(--color-base);
    border: 1px solid var(--color-accent-5);
    padding: var(--space-20);
    z-index: 10;
  }

  @media (max-width: 781px) {
    header { padding-inline: var(--space-30); align-items: center; }
    .logo :global(img) { width: 72px; height: 72px; }
    /* The stacked desktop column gives way to the menu button. */
    .right { display: none; }
  }
</style>
