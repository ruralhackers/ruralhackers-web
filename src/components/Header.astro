---
import { Image } from 'astro:assets'
import { NAV } from '../lib/nav.ts'
import LanguageLinks from './LanguageLinks.astro'
import { localePath, type Locale } from '../lib/i18n.ts'
import logo from '../assets/logo.png'

interface Props {
  locale: Locale
  path: string
  availableLocales: readonly Locale[]
}
const { locale, path, availableLocales } = Astro.props
const href = (h: string, external?: boolean) => (external ? h : localePath(locale, h))
---
{/*
  Measured on the live site at 1440px: the logo renders 120x120, the nav sits
  right-aligned in a 103px-wide box at x=1287, its <ul> is flex-direction column,
  and its items are 18px Inter. The header itself has no padding of its own.
*/}
<header>
  <a class="logo" href={localePath(locale, '/')} aria-label="Rural Hackers — home">
    <Image src={logo} alt="" width={120} height={120} layout="fixed" />
  </a>

  <div class="right">
    {/* Above the nav, in the same right-aligned column. */}
    <LanguageLinks locale={locale} path={path} availableLocales={availableLocales} />

    <nav aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li>
            <a
              href={href(item.href, item.external)}
              {...(item.external ? { rel: 'noopener', target: '_blank' } : {})}
            >{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((child) => (
                  <li><a href={href(child.href, child.external)}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    max-width: var(--wide-size);
    margin: 0 auto;
    padding: 0 var(--space-40);
  }
  .logo { display: block; line-height: 0; }
  .right { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-20); padding-top: var(--space-20); }

  nav ul {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 18px;
  }
  nav li { position: relative; }
  nav .sub { display: none; }
  nav li:hover > .sub,
  nav li:focus-within > .sub {
    display: flex;
    position: absolute;
    right: 0;
    background: var(--color-base);
    border: 1px solid var(--color-accent-5);
    padding: var(--space-20);
    z-index: 10;
  }

  @media (max-width: 781px) {
    header { padding-inline: var(--space-30); }
    .logo :global(img) { width: 72px; height: 72px; }
  }
</style>
