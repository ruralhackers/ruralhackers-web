---
import { ui } from '../lib/ui.ts'
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n.ts'

interface Props { locale?: Locale }
const { locale = DEFAULT_LOCALE } = Astro.props
const t = ui(locale)
const year = new Date().getFullYear()
/**
 * Replaces WPForms 716. Four real fields, all required; WPForms' field_4 was a
 * honeypot with a per-request randomised label.
 *
 * The motivation label said "Hacker Days 2025" on the live site; updated to the
 * current edition at the owners' request.
 */
---
<form name="hacker-days" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="hacker-days" />
  <p class="hidden">
    <label>{t.formHoneypot} <input name="bot-field" /></label>
  </p>

  <p>
    <label for="hd-name">{t.formName} <span class="req" aria-hidden="true">*</span></label>
    <input id="hd-name" type="text" name="name" required />
  </p>
  <p>
    <label for="hd-email">{t.formEmail} <span class="req" aria-hidden="true">*</span></label>
    <input id="hd-email" type="email" name="email" required />
  </p>
  <p>
    <label for="hd-motivation">{t.formMotivation} {year}?</label>
    <textarea id="hd-motivation" name="motivation" rows="5" required></textarea>
  </p>
  <p>
    <label for="hd-contribution">{t.formContribution}</label>
    <textarea id="hd-contribution" name="contribution" rows="5" required></textarea>
  </p>
  <p class="actions"><button type="submit">{t.formSubmit}</button></p>
</form>

<style>
  form { display: grid; gap: var(--space-30); max-width: var(--content-size); }
  form p { margin: 0; display: grid; gap: var(--space-20); }
  .hidden { position: absolute; left: -9999px; }
  input, textarea {
    font: inherit;
    font-size: var(--size-medium);
    padding: var(--space-20);
    border: 2px solid var(--color-accent-5);
    background: var(--color-base);
    color: var(--color-contrast);
  }
  label { font-weight: 700; font-size: var(--size-small); }
  .req { color: #d32f2f; }
  .actions { display: block; }
  button {
    font-family: var(--font-body);
    font-size: var(--size-small);
    border: 0;
    border-radius: 999px;
    background: var(--color-contrast);
    color: var(--color-base);
    padding: var(--space-20) var(--space-40);
    cursor: pointer;
  }
  button:hover { background: var(--color-accent-1); }
</style>
