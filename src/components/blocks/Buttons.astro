---
interface Props {
  align?: 'left' | 'center' | 'right'
}
const { align = 'left' } = Astro.props
const justify = align === 'left' ? 'flex-start' : align === 'right' ? 'flex-end' : 'center'
---
{/*
  Solid black pills, not outlined rectangles. Every call to action on the live
  site is a filled dark pill with light text — "Learn more", "Contact".
*/}
<div class="buttons" style={`--btn-justify: ${justify}`}><slot /></div>

<style>
  .buttons {
    display: flex;
    gap: var(--space-30);
    justify-content: var(--btn-justify);
    flex-wrap: wrap;
  }
  .buttons :global(a) {
    display: inline-block;
    background: var(--color-contrast);
    color: var(--color-base);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--size-small);
    padding: var(--space-20) var(--space-40);
    text-decoration: none;
  }
  .buttons :global(a:hover) {
    background: var(--color-accent-1);
    color: var(--color-base);
    text-decoration: none;
  }
</style>
