---
import { Picture } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  width?: number
  /** Applies the site's black-to-accent-1 duotone, as its orange bands do. */
  duotone?: boolean
}
const { src, alt, caption, width, duotone = false } = Astro.props
---
{/*
  alt is required, not optional. 215 of the 225 archived images have no alt text
  and phase 2 is the moment that stops being free — the type forces a decision,
  and `alt=""` is a valid, deliberate answer for decoration.
*/}
{/*
  Picture, not Image: only Picture accepts `formats`, so only Picture emits the
  avif and webp sources. `layout="constrained"` is what generates the srcset and
  sizes, so the browser can pick a width instead of always taking the largest.
*/}
<figure class:list={[duotone && 'duotone']}>
  <Picture
    src={src}
    alt={alt}
    width={width}
    formats={['avif', 'webp']}
    layout="constrained"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure { margin: 0; }
  .duotone :global(img) { filter: url(#duotone-accent-1); }
  figcaption {
    font-size: var(--size-small);
    color: var(--color-accent-4);
    margin-top: var(--space-20);
  }
</style>
