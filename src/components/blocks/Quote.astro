---
interface Props {
  cite?: string
}
const { cite } = Astro.props
---
<blockquote>
  <slot />
  {cite && <cite>{cite}</cite>}
</blockquote>

<style>
  blockquote {
    margin: 0;
    padding-inline-start: var(--space-40);
    border-inline-start: 4px solid var(--color-accent-1);
    font-family: var(--font-display);
  }
  cite {
    display: block;
    font-size: var(--size-small);
    color: var(--color-accent-4);
    font-style: normal;
  }
</style>
