{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  // `src/lib` and `tests` hold plain TypeScript, so tsc checks them directly.
  // The `.astro` files are checked by `astro check`, which understands them.
  "include": ["scraper/src", "src/lib", "tests"]
}
